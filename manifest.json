{
  "manifest_version": 3,
  "name": "Open Sesame",
  "version": "1.2.0",
  "description": "Save loaded Scribd embed pages as PDF, HTML, or Markdown.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "pageCapture", "downloads"],
  "host_permissions": ["https://www.scribd.com/*"],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Sesame",
    "default_popup": "popup.html"
  }
}
